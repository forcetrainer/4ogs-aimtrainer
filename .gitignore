# Godot engine binaries (download Godot 4.7.2 into tools/godot to run)
tools/

# Godot's import cache; rebuilt automatically
game/.godot/

# Editor and OS clutter
*.tmp
Thumbs.db
.DS_Store

# Raw asset downloads; only what is used gets copied into game/assets
downloads/

# Fab Standard License assets may not be redistributed as source files, so they
# stay out of version control. Re-download from Fab (see game/assets/kit/README.txt).
game/assets/kit/*.fbx
game/assets/kit/*.png
game/assets/kit/*.import

# Mixamo files may not be redistributed as source files either.
game/assets/enemy/*.fbx
game/assets/enemy/*.import
game/assets/enemy/*.png

# Built game
build/
